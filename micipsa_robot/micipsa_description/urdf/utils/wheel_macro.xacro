<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:macro name="wheel" params="
        name
        joint_name
        x_offset
        y_offset
        z_offset
    ">

        <!-- LINK -->
        <link name="${name}">

            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <material name="black">
                    <color rgba="0 0 0 1"/>
                </material>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>

            <surface>
                <friction>
                    <ode>
                        <mu>0.3</mu>
                        <mu2>0.3</mu2>
                    </ode>
                </friction>
            </surface>

            <xacro:cylinder_inertia
                mass="${wheel_mass}"
                length="${wheel_width}"
                radius="${wheel_radius}">
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            </xacro:cylinder_inertia>

        </link>

        <!-- JOINT -->
        <joint name="${joint_name}" type="continuous">
            <origin xyz="${x_offset} ${y_offset} ${z_offset}" rpy="0 0 0"/>
            <parent link="base_link"/>
            <child link="${name}"/>
            <axis xyz="0 1 0"/>
        </joint>

    </xacro:macro>

</robot>