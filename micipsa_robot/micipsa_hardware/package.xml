<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>micipsa_hardware</name>
  <version>1.0.0</version>
  <description>ros2_control hardware interface plugin for Micipsa, exposing the micipsa_core hardware abstraction as SystemInterface state and command interfaces.</description>
  <maintainer email="yousriouartsi@gmail.com">yousri</maintainer>
  <license>TODO: License declaration</license>

  <!-- ============ -->
  <!-- Build System -->
  <!-- ============ -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ================= -->
  <!-- Build Dependencies -->
  <!-- ================= -->
  <build_depend>micipsa_core</build_depend>
  <depend>micipsa_common</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rcpputils</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <!-- ==================== -->
  <!-- Runtime Dependencies -->
  <!-- ==================== -->

  <!-- ================= -->
  <!-- Test Dependencies -->
  <!-- ================= -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
